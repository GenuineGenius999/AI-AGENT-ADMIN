# =============================================================================
# FRONTEND ONLY — copy to frontend/.env
# Backend has its own env file: backend/.env.example
# Host frontend separately from the backend (different domain/server is fine).
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (browser-safe values only)
# Where: https://supabase.com → Project Settings → API
# -----------------------------------------------------------------------------

# Same as backend SUPABASE_URL
# Where: Project Settings → API → Project URL
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Same as backend SUPABASE_ANON_KEY
# Where: Project Settings → API → anon public
# Never put the service_role key in the frontend.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# -----------------------------------------------------------------------------
# BACKEND API URL (required when frontend & backend are hosted separately)
# -----------------------------------------------------------------------------
# Local backend:     http://localhost:4000
# Hosted backend:    https://your-backend.vercel.app
# No trailing slash.
VITE_API_BASE_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# SETUP CHECKLIST (frontend)
# -----------------------------------------------------------------------------
# 1. Copy this file to frontend/.env (and set the same on Vercel for frontend)
# 2. Fill VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
# 3. Set VITE_API_BASE_URL to your deployed backend URL
# 4. npm install && npm run dev
# 5. Open login page — it auto-creates admin via backend /api/setup/bootstrap
# 6. Sign in: admin@botservice.com / admin123456
